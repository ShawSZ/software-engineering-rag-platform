# Single-machine deployment: start-local.ps1 / start-local.cmd use bundle,h2.
# Create .env.local in the project root from this example; preserve existing values.
# The startup script reads values as data. Leave model credentials blank until set.
# H2 is embedded; course files are local and Caffeine runs in process.
SERVER_PORT=8088
STORAGE_PROVIDER=local
CACHE_PROVIDER=caffeine
STORAGE_LOCAL_DIR=./data/files

# Optional explicit database settings; blank preserves the bundled H2 default.
# Configure only this project's course database. Flyway rejects unknown non-empty schemas.
DB_URL=
DB_USER=
DB_PASSWORD=

# Optional: when blank, start-local.ps1 generates and persists a random local key.
JWT_SECRET=

# DeepSeek Chat Completions base URL (not the full /chat/completions endpoint).
DEEPSEEK_API_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash

# First administrator is initialized only when no administrator record exists.
APP_ADMIN_USERNAME=
APP_ADMIN_PASSWORD=
